APP_NAME="Wallet Yanga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match how you open the app (include :8000 for `php artisan serve`). Paychangu uses this for callback URLs.
# If you use XAMPP Apache on port 80, point the vhost/document root at the Laravel `public` folder and set APP_URL to that base.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=walletyanga
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
ALLOW_DESTRUCTIVE_DB_COMMANDS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# USD → MWK reference rate (used when live spot API fails)
FX_FALLBACK_MWK_PER_USD=1700
# Optional: override spot JSON URL (default: Cloudflare mirror of currency-api)
# FX_SPOT_URL=https://latest.currency-api.pages.dev/v1/currencies/usd.json
# FX_SPOT_CACHE_TTL=900
# FX_MIN_DEPOSIT_MWK_MINOR=10000
# FX_MAX_DEPOSIT_MWK_MINOR=50000000
# FX_CONVERSION_SPREAD_BPS=150
# FX_MIN_CONVERSION_MWK_MINOR=1000

# Paychangu (https://developer.paychangu.com) — use test keys from dashboard for sandbox
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_SECRET_KEY=
# Optional: set when you enable signed webhooks in Paychangu (recommended in production)
PAYCHANGU_WEBHOOK_SECRET=

# Virtual card issuer. Use sandbox for local demo cards.
CARD_ISSUER=sandbox
SUDO_BASE_URL=https://api.sandbox.sudo.cards
SUDO_VAULT_URL=https://vault.sandbox.sudo.cards
SUDO_API_KEY=
SUDO_AUTH_SCHEME=Bearer
SUDO_CARD_CURRENCY=USD
SUDO_CARD_BRAND=Visa
SUDO_ISSUER_COUNTRY=USA
SUDO_BILLING_COUNTRY=MW
SUDO_POSTAL_CODE=00000
SUDO_ACCOUNT_TYPE=wallet
SUDO_ACCOUNT_KIND=Savings
SUDO_DEFAULT_DAILY_LIMIT_MINOR=5000
